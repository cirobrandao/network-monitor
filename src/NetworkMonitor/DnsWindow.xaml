<Window x:Class="NetworkMonitor.DnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkMonitor"
        Title="Teste de DNS"
        Height="520" Width="720"
        MinHeight="360" MinWidth="560"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
  <Window.DataContext>
    <Binding Source="{x:Static local:AppState.Current}" />
  </Window.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource HeaderBrush}">
      <StackPanel>
        <TextBlock Text="Teste de DNS" FontSize="16" FontWeight="SemiBold" Foreground="White" />
        <TextBlock Text="Ferramenta avulsa para medir o tempo de resposta dos servidores."
                   Foreground="#B8C5D1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding DnsStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
      <StackPanel>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="14">
          <StackPanel>
            <TextBlock Text="Hosts para consultar" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding DnsHosts, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Testar DNS"
                      Margin="10,0,0,0" Click="RunDns_Click" IsEnabled="{Binding DnsIdle}" />
            </Grid>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding DnsResults}" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" />
                  <TextBlock Grid.Column="2" Text="{Binding AverageText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="3" Text="{Binding Status}" />
                  <TextBlock Grid.Column="4" Text="{Binding SamplesText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
