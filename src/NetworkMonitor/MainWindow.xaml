<Window x:Class="NetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkMonitor"
        Title="Network Monitor"
        Height="760" Width="1180"
        MinHeight="560"
        MinWidth="880"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Window.DataContext>
    <Binding Source="{x:Static local:AppState.Current}" />
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource HeaderBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowPublicIp, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="IP EXTERNO" FontSize="10" Foreground="#8FD4C0" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PublicIp}" Style="{StaticResource IpText}" Tag="{Binding PublicIp}"
                     MouseLeftButtonUp="CopyIp_MouseUp" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
          <StackPanel Margin="0,0,22,0" MinWidth="120">
            <TextBlock Text="DOWNLOAD" FontSize="10" Foreground="#8FD4C0" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DownText}" FontSize="18" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="NoWrap" />
          </StackPanel>
          <StackPanel MinWidth="120">
            <TextBlock Text="UPLOAD" FontSize="10" Foreground="#9DC4E8" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UpText}" FontSize="18" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="NoWrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource HeaderButton}" Click="ToggleOverlay_Click" Margin="0,0,8,0" ToolTip="Mostrar ou ocultar o widget">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Widget" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HeaderButton}" Click="Export_Click" Margin="0,0,8,0" ToolTip="Exportar conexões em CSV">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDE1;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Exportar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HeaderButton}" Click="OpenDns_Click" Margin="0,0,8,0" ToolTip="Testar servidores DNS">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="DNS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AccentButton}" Click="OpenSettings_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Ajustes" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="16,8" Background="{DynamicResource PeakBannerBrush}"
            BorderBrush="{DynamicResource PeakBannerBorderBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding IsPeaking, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding PeakText}" Foreground="{DynamicResource PeakBrush}" FontWeight="SemiBold" />
    </Border>

    <Border Grid.Row="2" Padding="16,10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Filtrar por aplicativo, IP, host ou PID"
                     Foreground="{DynamicResource MutedBrush}"
                     IsHitTestVisible="False"
                     Margin="10,6,0,0"
                     VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Search}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Segment}" Content="Aplicativos"
                           IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Processes}" />
              <RadioButton Style="{StaticResource Segment}" Content="IPs"
                           IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Addresses}" />
              <RadioButton Style="{StaticResource Segment}" Content="Ativas"
                           IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Connections}" />
              <RadioButton Style="{StaticResource Segment}" Content="Encerradas"
                           IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Closed}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="12,10,12,0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
          <TextBlock Text="TRÁFEGO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton Style="{StaticResource Segment}" Content="Linha" IsChecked="{Binding ChartLine}" />
            <RadioButton Style="{StaticResource Segment}" Content="Área" IsChecked="{Binding ChartArea}" />
            <RadioButton Style="{StaticResource Segment}" Content="Barras" IsChecked="{Binding ChartBar}" />
            <Button Style="{StaticResource IconToolButton}" ToolTip="{Binding ChartEyeTip}"
                    Click="ToggleChart_Click" Margin="8,0,0,0"
                    AutomationProperties.Name="{Binding ChartEyeTip}">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding ChartEyeGlyph}" FontSize="14" />
            </Button>
          </StackPanel>
        </Grid>
        <local:BandwidthChart Height="140" DataContext="{Binding}"
                              Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="4" Margin="12">
      <ScrollViewer Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Processes}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Processes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,1" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                    <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,10,0">
                      <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" />
                      <Border Background="{DynamicResource Surface2Brush}" Visibility="{Binding Icon, Converter={StaticResource NullIcon}}">
                        <TextBlock Text="•" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11">
                        <Run Text="{Binding PidSummary, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CountLabel, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding RateText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Grid.Column="4" Style="{StaticResource IconToolButton}" ToolTip="{Binding BlockLabel}"
                            Click="BlockProcess_Click" Tag="{Binding}" Foreground="{Binding IsBlocked, Converter={StaticResource BlockedBrush}}">
                      <TextBlock Style="{StaticResource Glyph}" Text="{Binding BlockGlyph}" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Connections}" Margin="38,8,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding ProtocolText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding FlagImage}" Width="16" Height="11" Stretch="Uniform"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ToolTip="{Binding GeoText}"
                                   Visibility="{Binding CountryCode, Converter={StaticResource NonEmptyVis}}" />
                            <TextBlock Text="{Binding RemoteDisplay}" Style="{StaticResource IpText}" VerticalAlignment="Center"
                                       Tag="{Binding RemoteAddress}" MouseLeftButtonUp="CopyIp_MouseUp" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding HostDisplay}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding RateText}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Style="{StaticResource Glyph}" Text="{Binding State, Converter={StaticResource StateIcon}}"
                                     Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                     ToolTip="{Binding State, Converter={StaticResource State}}" />
                          <TextBlock Grid.Column="5" Style="{StaticResource Glyph}" Text="{Binding Scope, Converter={StaticResource ScopeIcon}}"
                                     Foreground="{Binding Scope, Converter={StaticResource ScopeBrush}}"
                                     ToolTip="{Binding Scope, Converter={StaticResource Scope}}" />
                          <Button Grid.Column="6" Style="{StaticResource IconToolButton}" ToolTip="Bloquear IP"
                                  Click="BlockConnectionIp_Click" Tag="{Binding}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xF140;" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ScrollViewer Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Addresses}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Addresses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,1" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding FlagImage}" Width="16" Height="11" Stretch="Uniform"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="{Binding GeoText}"
                               Visibility="{Binding CountryCode, Converter={StaticResource NonEmptyVis}}" />
                        <TextBlock Text="{Binding Address}" Style="{StaticResource IpText}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Tag="{Binding Address}" MouseLeftButtonUp="CopyIp_MouseUp" />
                      </StackPanel>
                      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding RateText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Grid.Column="4" Style="{StaticResource IconToolButton}" ToolTip="{Binding BlockLabel}"
                            Click="BlockIp_Click" Tag="{Binding}" Foreground="{Binding IsBlocked, Converter={StaticResource BlockedBrush}}">
                      <TextBlock Style="{StaticResource Glyph}" Text="{Binding BlockGlyph}" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Connections}" Margin="38,8,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding ProcessName}" />
                          <TextBlock Grid.Column="2" Text="{Binding LocalDisplay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedBrush}" />
                          <TextBlock Grid.Column="3" Text="{Binding RateText}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                          <TextBlock Grid.Column="4" Style="{StaticResource Glyph}" Text="{Binding State, Converter={StaticResource StateIcon}}"
                                     Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                     ToolTip="{Binding State, Converter={StaticResource State}}" />
                          <Button Grid.Column="5" Style="{StaticResource IconToolButton}" ToolTip="Bloquear aplicativo"
                                  Click="BlockConnectionApp_Click" Tag="{Binding}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xF140;" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <DockPanel Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Connections}">
        <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1.9*" />
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="28" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Aplicativo" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="1" Text="PID" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Proto" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="3" Text="Local" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="4" Text="Remoto" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="5" Text="Host" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="6" Text="Velocidade" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
        </Grid>
        <ListView x:Name="ConnectionsList" ItemsSource="{Binding Connections}"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="Connections_MouseDoubleClick">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,1" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.8*" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="1.4*" />
                  <ColumnDefinition Width="1.9*" />
                  <ColumnDefinition Width="1.3*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding ProtocolText}" />
                <TextBlock Grid.Column="3" Text="{Binding LocalDisplay}" Style="{StaticResource IpText}" FontSize="12"
                           Tag="{Binding LocalAddress}" MouseLeftButtonUp="CopyIp_MouseUp" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                  <Image Source="{Binding FlagImage}" Width="16" Height="11" Stretch="Uniform"
                         Margin="0,0,8,0" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         ToolTip="{Binding GeoText}"
                         Visibility="{Binding CountryCode, Converter={StaticResource NonEmptyVis}}" />
                  <TextBlock Text="{Binding RemoteDisplay}" Style="{StaticResource IpText}" FontSize="12" VerticalAlignment="Center"
                             Tag="{Binding RemoteAddress}" MouseLeftButtonUp="CopyIp_MouseUp" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding HostDisplay}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6" Text="{Binding RateText}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                <TextBlock Grid.Column="7" Style="{StaticResource Glyph}" Text="{Binding State, Converter={StaticResource StateIcon}}"
                           Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                           ToolTip="{Binding State, Converter={StaticResource State}}" />
                <TextBlock Grid.Column="8" Style="{StaticResource Glyph}" Text="{Binding Scope, Converter={StaticResource ScopeIcon}}"
                           Foreground="{Binding Scope, Converter={StaticResource ScopeBrush}}"
                           ToolTip="{Binding Scope, Converter={StaticResource Scope}}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copiar IP remoto" Click="CopyRemote_Click" />
              <MenuItem Header="Copiar aplicativo" Click="CopyProcess_Click" />
              <MenuItem Header="Copiar linha" Click="CopyRow_Click" />
              <Separator />
              <MenuItem Header="Bloquear aplicativo" Click="BlockSelectedApp_Click" />
              <MenuItem Header="Bloquear IP" Click="BlockSelectedIp_Click" />
              <MenuItem Header="Bloquear app neste IP" Click="BlockSelectedAppIp_Click" />
            </ContextMenu>
          </ListView.ContextMenu>
        </ListView>
      </DockPanel>

      <DockPanel Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Closed}">
        <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Aplicativo" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="1" Text="PID" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Remoto" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="3" Text="Host" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="4" Text="Encerrou" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="5" Text="Durou" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="6" Text="Há" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
        </Grid>
        <ListView ItemsSource="{Binding ClosedConnections}"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,1" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListViewItem">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6">
                      <ContentPresenter />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.8*" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1.4*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Image Source="{Binding FlagImage}" Width="16" Height="11" Stretch="Uniform"
                         Margin="0,0,8,0" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         ToolTip="{Binding GeoText}"
                         Visibility="{Binding CountryCode, Converter={StaticResource NonEmptyVis}}" />
                  <TextBlock Text="{Binding RemoteDisplay}" Style="{StaticResource IpText}" FontSize="12" VerticalAlignment="Center"
                             Tag="{Binding RemoteAddress}" MouseLeftButtonUp="CopyIp_MouseUp" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding HostDisplay}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding EndedLabel}" />
                <TextBlock Grid.Column="5" Text="{Binding DurationLabel}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="6" Text="{Binding AgoLabel}" Foreground="{DynamicResource MutedBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </DockPanel>
    </Grid>

    <Border Grid.Row="5" Padding="16,8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                  Content="{Binding UpdateLabel}"
                  Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                  Click="ApplyUpdate_Click" Margin="0,0,14,0" ToolTip="Há uma versão nova no GitHub" />
          <TextBlock Text="{Binding VersionLabel}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="·" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock FontSize="12" VerticalAlignment="Center">
            <Hyperlink NavigateUri="https://cirobrandao.com.br/" RequestNavigate="Site_RequestNavigate">cirobrandao.com.br</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="6" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#66000000" MouseDown="CloseSettingsScrim_MouseDown" />
      <Border HorizontalAlignment="Right" Width="400" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0"
                    ToolTip="Fechar ajustes" AutomationProperties.Name="Fechar ajustes" Click="CloseSettings_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
            </Button>
            <TextBlock Text="Ajustes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <TextBlock Style="{StaticResource SettingsSection}" Text="Aparência" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource SettingsHint}" Text="Aplica na janela e no widget." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <RadioButton Style="{StaticResource Segment}" GroupName="AppTheme" Content="Cor do sistema" IsChecked="{Binding ThemeIsSystem}" />
              <RadioButton Style="{StaticResource Segment}" GroupName="AppTheme" Content="Claro" IsChecked="{Binding ThemeIsLight}" />
              <RadioButton Style="{StaticResource Segment}" GroupName="AppTheme" Content="Escuro" IsChecked="{Binding ThemeIsDark}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SettingsSection}" Text="Widget" />
            <CheckBox Content="Mostrar widget" IsChecked="{Binding ShowOverlay}" />
            <TextBlock Text="Gráfico do widget" Style="{StaticResource SettingsHint}" Margin="0,4,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Style="{StaticResource Segment}" GroupName="OverlayChart" Content="Linha" IsChecked="{Binding OverlayChartLine}" />
              <RadioButton Style="{StaticResource Segment}" GroupName="OverlayChart" Content="Área" IsChecked="{Binding OverlayChartArea}" />
              <RadioButton Style="{StaticResource Segment}" GroupName="OverlayChart" Content="Barras" IsChecked="{Binding OverlayChartBar}" />
            </StackPanel>
            <TextBlock Text="Modelo" Style="{StaticResource SettingsHint}" Margin="0,4,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Style="{StaticResource Segment}" GroupName="OverlayMode" Content="Completo" IsChecked="{Binding OverlayComplete}" />
              <RadioButton Style="{StaticResource Segment}" GroupName="OverlayMode" Content="Simples" IsChecked="{Binding OverlayCompact}" />
            </StackPanel>
            <CheckBox Content="Clique atravessa o overlay" IsChecked="{Binding OverlayClickThrough}" />
            <TextBlock Text="Opacidade do widget" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,4" />
            <Slider Minimum="0.3" Maximum="1" Value="{Binding OverlayOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,4" />

            <TextBlock Style="{StaticResource SettingsSection}" Text="Janela" />
            <CheckBox Content="Mostrar IP externo" IsChecked="{Binding ShowPublicIp}" />
            <CheckBox Content="Mostrar gráfico de tráfego" IsChecked="{Binding ShowChart}" />

            <TextBlock Style="{StaticResource SettingsSection}" Text="Alertas de pico" />
            <CheckBox Content="Alertar picos de consumo" IsChecked="{Binding PeakAlertEnabled}" />
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Download (MB/s)" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <TextBox Text="{Binding PeakDownText, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Upload (MB/s)" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <TextBox Text="{Binding PeakUpText, UpdateSourceTrigger=LostFocus}" />
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SettingsSection}" Text="Histórico" />
            <TextBlock Style="{StaticResource SettingsHint}" Text="Quanto tempo manter conexões encerradas." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <RadioButton Style="{StaticResource Segment}" Content="5 min" IsChecked="{Binding Retention5}" />
              <RadioButton Style="{StaticResource Segment}" Content="10 min" IsChecked="{Binding Retention10}" />
              <RadioButton Style="{StaticResource Segment}" Content="30 min" IsChecked="{Binding Retention30}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SettingsSection}" Text="Inicialização" />
            <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" />
            <CheckBox Content="Começar minimizado na bandeja" IsChecked="{Binding StartMinimized}" />

            <TextBlock Style="{StaticResource SettingsSection}" Text="Filtros" />
            <CheckBox Content="Somente TCP estabelecidas" IsChecked="{Binding EstablishedOnly}" />
            <CheckBox Content="Mostrar binds UDP" IsChecked="{Binding ShowUdp}" />
            <CheckBox Content="Ocultar loopback" IsChecked="{Binding HideLoopback}" />
            <CheckBox Content="Ocultar IPs da rede local" IsChecked="{Binding HidePrivate}" />
            <CheckBox Content="Resolver nomes DNS" IsChecked="{Binding ResolveDns}" />

            <TextBlock Style="{StaticResource SettingsSection}" Text="Atualização da lista" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <RadioButton Style="{StaticResource Segment}" Content="0,5 s" IsChecked="{Binding RefreshFast}" />
              <RadioButton Style="{StaticResource Segment}" Content="1 s" IsChecked="{Binding RefreshNormal}" />
              <RadioButton Style="{StaticResource Segment}" Content="2 s" IsChecked="{Binding RefreshSlow}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SettingsSection}" Text="Firewall" />
            <TextBlock Text="{Binding ElevationText}" Style="{StaticResource SettingsHint}" />
            <Button Style="{StaticResource GhostButton}" Content="Medir velocidade de cada IP"
                    Click="RestartAdmin_Click" HorizontalAlignment="Left"
                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisInv}}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding BlockRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Style="{StaticResource IconToolButton}" ToolTip="Remover bloqueio"
                            Click="RemoveBlock_Click" Tag="{Binding}">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nenhum bloqueio ativo." Foreground="{DynamicResource MutedBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BlockRules.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <TextBlock Style="{StaticResource SettingsSection}" Text="Adaptadores" />
            <ItemsControl ItemsSource="{Binding Adapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Enabled}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource GhostButton}" Content="Fechar" Margin="0,16,0,8" Click="CloseSettings_Click" />
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="6" Visibility="{Binding DnsOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#66000000" MouseDown="CloseDnsScrim_MouseDown" />
      <Border HorizontalAlignment="Right" Width="440" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0"
                    ToolTip="Fechar teste de DNS" Click="CloseDns_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
            </Button>
            <StackPanel>
              <TextBlock Text="Teste de DNS" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Compara o tempo de resposta dos servidores." Style="{StaticResource SettingsHint}" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding DnsStatus}" Margin="0,12,0,0"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Hosts" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
              <TextBox Text="{Binding DnsHosts, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
              <Button Style="{StaticResource AccentButton}" Content="Testar agora"
                      Click="RunDns_Click" IsEnabled="{Binding DnsIdle}" HorizontalAlignment="Left" Margin="0,0,0,16" />
              <ItemsControl ItemsSource="{Binding DnsResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <Border Background="#0D7A5F" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}">
                              <TextBlock Text="Mais rápido" FontSize="10" Foreground="White" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                          <TextBlock Text="{Binding SamplesText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                     TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                          <TextBlock Text="{Binding AverageText}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
