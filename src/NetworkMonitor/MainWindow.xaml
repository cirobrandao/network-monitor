<Window x:Class="NetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkMonitor"
        Title="Network Monitor"
        Height="760" Width="1180"
        MinHeight="560"
        MinWidth="880"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Window.DataContext>
    <Binding Source="{x:Static local:AppState.Current}" />
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="20,16,20,12" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/app.png" Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel>
            <TextBlock Text="Network Monitor" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Conexões, aplicativos e taxa de internet" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
          <Border Background="#12261C" CornerRadius="12" Padding="16,10" Margin="0,0,10,0" Width="210">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="DOWNLOAD" FontSize="11" Foreground="{StaticResource DownBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DownText}" FontSize="22" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
              </StackPanel>
              <Polyline Grid.Column="1" Points="{Binding DownSpark}" Stroke="{StaticResource DownBrush}" StrokeThickness="1.6" Width="90" Height="28" Stretch="Fill" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Background="#121A2A" CornerRadius="12" Padding="16,10" Width="210">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="UPLOAD" FontSize="11" Foreground="{StaticResource UpBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UpText}" FontSize="22" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
              </StackPanel>
              <Polyline Grid.Column="1" Points="{Binding UpSpark}" Stroke="{StaticResource UpBrush}" StrokeThickness="1.6" Width="90" Height="28" Stretch="Fill" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Content="Overlay" Click="ToggleOverlay_Click" Margin="0,0,8,0" />
          <Button Style="{StaticResource GhostButton}" Content="Exportar" Click="Export_Click" Margin="0,0,8,0" />
          <Button Style="{StaticResource AccentButton}" Content="Ajustes" Click="OpenSettings_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="20,12" Background="#0E141B">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Filtrar por aplicativo, IP, host ou PID"
                     Foreground="{StaticResource MutedBrush}"
                     IsHitTestVisible="False"
                     Margin="18,8,0,0"
                     VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Search}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Border Grid.Column="1" Margin="12,0,0,0" Background="#10161E" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" Content="Aplicativos"
                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Processes}" />
            <RadioButton Style="{StaticResource Segment}" Content="IPs"
                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Addresses}" />
            <RadioButton Style="{StaticResource Segment}" Content="Conexões"
                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Connections}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="16,8,16,8">
      <!-- Processes -->
      <ScrollViewer Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Processes}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Processes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                  <Expander.Header>
                    <Grid Margin="4,6,12,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="22" Height="22" Margin="0,0,10,0">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" />
                        <Border Background="#2A3646" CornerRadius="4" Visibility="{Binding Icon, Converter={StaticResource NullIcon}}">
                          <TextBlock Text="•" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                          <Run Text="{Binding PidSummary, Mode=OneWay}" />
                          <Run Text=" · " />
                          <Run Text="{Binding CountLabel, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Connections}" Margin="36,0,12,10">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding ProtocolText}" Foreground="{StaticResource MutedBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding RemoteDisplay}" FontFamily="{StaticResource MonoFont}" />
                          <TextBlock Grid.Column="2" Text="{Binding HostDisplay}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding State, Converter={StaticResource State}}" />
                          <TextBlock Grid.Column="4" Text="{Binding Scope, Converter={StaticResource Scope}}" Foreground="{Binding Scope, Converter={StaticResource ScopeBrush}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- IPs -->
      <ScrollViewer Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Addresses}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Addresses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                  <Expander.Header>
                    <StackPanel Margin="4,6,12,6">
                      <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                        <Run Text="{Binding HostDisplay, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Scope, Converter={StaticResource Scope}, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CountLabel, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Connections}" Margin="16,0,12,10">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                          </Grid.ColumnDefinitions>
                          <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding ProcessName}" />
                          <TextBlock Grid.Column="2" Text="{Binding LocalDisplay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" />
                          <TextBlock Grid.Column="3" Text="{Binding State, Converter={StaticResource State}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Connections -->
      <DockPanel Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Connections}">
        <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="1.6*" />
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="1.6*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Aplicativo" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="1" Text="PID" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Proto" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="3" Text="Local" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="4" Text="Remoto" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="5" Text="Host" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="6" Text="Estado" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          <TextBlock Grid.Column="7" Text="Escopo" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </Grid>
        <ListView x:Name="ConnectionsList" ItemsSource="{Binding Connections}"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="Connections_MouseDoubleClick">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,2" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="#141A22" CornerRadius="8" Padding="8,7">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#1B2430" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.1*" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="1.6*" />
                  <ColumnDefinition Width="1.8*" />
                  <ColumnDefinition Width="1.6*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding ProtocolText}" />
                <TextBlock Grid.Column="3" Text="{Binding LocalDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                <TextBlock Grid.Column="4" Text="{Binding RemoteDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                <TextBlock Grid.Column="5" Text="{Binding HostDisplay}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6" Text="{Binding State, Converter={StaticResource State}}" />
                <TextBlock Grid.Column="7" Text="{Binding Scope, Converter={StaticResource Scope}}" Foreground="{Binding Scope, Converter={StaticResource ScopeBrush}}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copiar IP remoto" Click="CopyRemote_Click" />
              <MenuItem Header="Copiar aplicativo" Click="CopyProcess_Click" />
              <MenuItem Header="Copiar linha" Click="CopyRow_Click" />
            </ContextMenu>
          </ListView.ContextMenu>
        </ListView>
      </DockPanel>
    </Grid>

    <Border Grid.Row="3" Padding="20,10" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Text="Fecha para a bandeja · clique duplo no overlay abre esta janela" />
      </Grid>
    </Border>

    <!-- Settings flyout -->
    <Grid Grid.RowSpan="4" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#99000000" MouseDown="CloseSettingsScrim_MouseDown" />
      <Border HorizontalAlignment="Right" Width="380" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Ajustes" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16" />

            <TextBlock Text="Overlay" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
            <CheckBox Style="{StaticResource Switch}" Content="Mostrar overlay de velocidade" IsChecked="{Binding ShowOverlay}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Clique atravessa o overlay" IsChecked="{Binding OverlayClickThrough}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Modo compacto" IsChecked="{Binding OverlayCompact}" Margin="0,0,0,12" />
            <TextBlock Text="Opacidade" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
            <Slider Minimum="0.45" Maximum="1" Value="{Binding OverlayOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,18" />

            <TextBlock Text="Inicialização" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
            <CheckBox Style="{StaticResource Switch}" Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Começar minimizado na bandeja" IsChecked="{Binding StartMinimized}" Margin="0,0,0,18" />

            <TextBlock Text="Filtros" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
            <CheckBox Style="{StaticResource Switch}" Content="Somente TCP estabelecidas" IsChecked="{Binding EstablishedOnly}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Mostrar binds UDP" IsChecked="{Binding ShowUdp}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Ocultar loopback" IsChecked="{Binding HideLoopback}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Ocultar IPs da rede local" IsChecked="{Binding HidePrivate}" Margin="0,0,0,10" />
            <CheckBox Style="{StaticResource Switch}" Content="Resolver nomes DNS" IsChecked="{Binding ResolveDns}" Margin="0,0,0,18" />

            <TextBlock Text="Atualização" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <RadioButton Style="{StaticResource Segment}" Content="0,5 s" IsChecked="{Binding RefreshFast}" />
              <RadioButton Style="{StaticResource Segment}" Content="1 s" IsChecked="{Binding RefreshNormal}" />
              <RadioButton Style="{StaticResource Segment}" Content="2 s" IsChecked="{Binding RefreshSlow}" />
            </StackPanel>

            <TextBlock Text="Adaptadores" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Adapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource GhostButton}" Content="Fechar" Margin="0,12,0,8" Click="CloseSettings_Click" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
