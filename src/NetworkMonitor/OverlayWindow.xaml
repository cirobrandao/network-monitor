<Window x:Class="NetworkMonitor.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkMonitor"
        Title="Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="360"
        Height="64"
        FontFamily="{StaticResource UiFont}">
  <Window.DataContext>
    <Binding Source="{x:Static local:AppState.Current}" />
  </Window.DataContext>
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Abrir monitor" Click="OpenMain_Click" />
      <MenuItem Header="Mostrar conexões" IsCheckable="True" IsChecked="{Binding OverlayShowConnections}" />
      <MenuItem Header="Mostrar IP público" IsCheckable="True" IsChecked="{Binding OverlayShowPublicIp}" />
      <MenuItem Header="Modo compacto" IsCheckable="True" IsChecked="{Binding OverlayCompact}" />
      <MenuItem Header="Clique atravessa" IsCheckable="True" IsChecked="{Binding OverlayClickThrough}" />
      <Separator />
      <MenuItem Header="Ocultar widget" Click="HideOverlay_Click" />
      <MenuItem Header="Sair" Click="Exit_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <Border x:Name="Card"
          BorderThickness="1"
          MouseLeftButtonDown="Card_MouseLeftButtonDown"
          MouseLeftButtonUp="Card_MouseLeftButtonUp">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="#C9D2DB" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsPeaking}" Value="True">
            <Setter Property="BorderBrush" Value="#B42318" />
            <Setter Property="Background" Value="#FFF8F4" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid Margin="12,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Polygon Points="0,0 7,0 3.5,6" Fill="#1A8F5A" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="{Binding DownText}" FontSize="15" FontWeight="SemiBold"
                     FontFamily="{StaticResource MonoFont}" Foreground="#1A8F5A"
                     TextWrapping="NoWrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Polygon Points="3.5,0 7,6 0,6" Fill="#2B6BCF" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="{Binding UpText}" FontSize="15" FontWeight="SemiBold"
                     FontFamily="{StaticResource MonoFont}" Foreground="#2B6BCF"
                     TextWrapping="NoWrap" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ConnectionCountText}"
                   VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="#5E6B7A" FontSize="13" TextWrapping="NoWrap"
                   Visibility="{Binding OverlayShowConnections, Converter={StaticResource BoolToVis}}" />
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,4,0,0"
                 Visibility="{Binding OverlayDetailsVisible, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding PeakText}" Foreground="#B42318" FontSize="11" FontWeight="SemiBold"
                   Visibility="{Binding IsPeaking, Converter={StaticResource BoolToVis}}"
                   Margin="0,0,10,0" TextWrapping="NoWrap" />
        <TextBlock HorizontalAlignment="Right"
                   Visibility="{Binding OverlayShowPublicIp, Converter={StaticResource BoolToVis}}"
                   Foreground="#5E6B7A" FontSize="12" FontFamily="{StaticResource MonoFont}"
                   Text="{Binding PublicIp}" TextWrapping="NoWrap" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
