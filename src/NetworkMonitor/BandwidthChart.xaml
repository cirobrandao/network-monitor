<UserControl x:Class="NetworkMonitor.BandwidthChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="0">
  <Grid x:Name="Root" Background="Transparent" ClipToBounds="True">
    <Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="Plot_SizeChanged" />
    <StackPanel x:Name="Legend" Orientation="Horizontal" Margin="8,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
      <Rectangle Width="8" Height="8" Fill="#0D7A5F" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock Text="Download" FontSize="10" Foreground="#5C6773" Margin="0,0,12,0" />
      <Rectangle Width="8" Height="8" Fill="#1A5FA8" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock Text="Upload" FontSize="10" Foreground="#5C6773" />
    </StackPanel>
    <TextBlock x:Name="ScaleLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,4,8,0" FontSize="10" Foreground="#5C6773" IsHitTestVisible="False" />
  </Grid>
</UserControl>
