<UserControl x:Class="NetworkMonitor.BandwidthChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="120">
  <Grid Background="White">
    <Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="Plot_SizeChanged" />
    <StackPanel Orientation="Horizontal" Margin="8,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
      <Rectangle Width="10" Height="10" Fill="#1A8F5A" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock Text="Download" FontSize="11" Foreground="#5E6B7A" Margin="0,0,12,0" />
      <Rectangle Width="10" Height="10" Fill="#2B6BCF" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock Text="Upload" FontSize="11" Foreground="#5E6B7A" />
    </StackPanel>
    <TextBlock x:Name="ScaleLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,6,8,0" FontSize="11" Foreground="#5E6B7A" IsHitTestVisible="False" />
  </Grid>
</UserControl>
